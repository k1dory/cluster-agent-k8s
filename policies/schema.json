{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-sandbox.dev/schemas/policy.json",
  "title": "agent-sandbox egress policy",
  "description": "What one agent slug may reach through the gateway. Deny by default.",
  "type": "object",
  "required": ["allow"],
  "additionalProperties": false,
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$", "description": "Agent definition name; defaults to the file name." },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "allow": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["host", "paths"],
        "additionalProperties": false,
        "properties": {
          "host": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$", "description": "Plain DNS name; the gateway issues a certificate per name." },
          "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^/" }, "description": "Globs: * one segment, ** any segments." },
          "methods": { "type": "array", "items": { "type": "string", "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"] } },
          "inject": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Header → value; `secret:NAME` is resolved per tenant at the gateway." },
          "mcp": { "type": "object", "additionalProperties": false, "properties": { "read_only": { "type": "boolean" } } },
          "upstream": { "type": "string", "pattern": "^https?://" }
        }
      }
    }
  }
}
