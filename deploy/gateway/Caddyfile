# agent-sandbox gateway. Runs on the gateway VM (10.77.77.1), the only thing agent pods can reach.
#
# Three roles:
#   1. egress: every allowlisted external host name resolves (via dnsmasq) to this VM; Caddy
#      terminates TLS with its internal CA, demands the agent's client certificate, asks
#      sandboxd /authz, copies the injected secret headers and proxies to the real host.
#   2. registrar: https://registrar.sandbox.internal:8443 without client auth (the pod has
#      no certificate yet), proxied to sandboxd /bootstrap only.
#   3. preview: *.preview.<domain> from the outside world to sandboxd's ingress listener.
#
# Replace example.com names and the sandboxd address, then `caddy validate --config Caddyfile`.
{
	# Caddy runs unprivileged and must not touch the system trust store.
	skip_install_trust
	# Internal CA that signs the server certificates agents see. Its root is exported with
	# `caddy trust` (or from /data/caddy/pki/authorities/local/root.crt) and handed to pods
	# by the Registrar (ca.gateway_ca_file in sandboxd.yaml).
	pki {
		ca local {
			name "agent-sandbox gateway"
		}
	}
	on_demand_tls {
		ask http://127.0.0.1:8082/__sandbox/ask
	}
	log {
		output file /var/log/caddy/access.json {
			roll_size 100mb
			roll_keep 30
		}
		format json
	}
}

# ---------- egress: one block per allowlisted host --------------------------------------
# Add a host here AND in dnsmasq.d/sandbox.conf AND in a policy file; all three are needed.

(agent_mtls) {
	tls {
		issuer internal
		client_auth {
			mode require_and_verify
			# agent CA root from sandboxd (var/ca/ca.crt), copied here by deploy.
			trust_pool file /etc/caddy/agent-ca.crt
		}
	}
	forward_auth 127.0.0.1:8081 {
		uri /authz
		header_up X-Agent-Cert {http.request.tls.client.certificate_der_base64}
		header_up X-Agent-SAN {http.request.tls.client.san.uris}
		# headers sandboxd may set on 200; everything else from its response is dropped.
		copy_headers Authorization X-Api-Key X-Agent-Slug X-Agent-Instance X-Agent-Tenant X-Agent-Sandbox X-Agent-Access
	}
	# Never let the agent smuggle these in itself (forward_auth copy would overwrite, but be explicit).
	request_header -X-Agent-Cert
	request_header -X-Agent-SAN
}

git.example.com {
	import agent_mtls
	reverse_proxy https://git.example.com {
		transport http {
			# upstream is resolved with the VM's normal resolver, not dnsmasq (see install.sh)
			tls_server_name git.example.com
		}
	}
}

api.anthropic.com {
	import agent_mtls
	reverse_proxy https://api.anthropic.com {
		# the agent must not carry its own key; the injected x-api-key wins
		header_up -Authorization
		transport http {
			tls_server_name api.anthropic.com
		}
		flush_interval -1
	}
}

mcp.example.com {
	import agent_mtls
	reverse_proxy https://mcp.example.com {
		transport http {
			tls_server_name mcp.example.com
		}
		flush_interval -1
	}
}

netbox.example.com {
	import agent_mtls
	reverse_proxy https://netbox.example.com {
		transport http {
			tls_server_name netbox.example.com
		}
	}
}

# Agent-facing control plane API (runs, output, input). Same mTLS, policy allows /agent/** per slug.
api.sandbox.internal {
	import agent_mtls
	reverse_proxy 127.0.0.1:8081 {
		flush_interval -1
	}
}

# ---------- registrar: reachable without a client certificate, bootstrap only --------------
registrar.sandbox.internal:8443 {
	tls {
		issuer internal
	}
	@bootstrap path /bootstrap
	handle @bootstrap {
		reverse_proxy 127.0.0.1:8081
	}
	handle {
		respond 404
	}
}

# ---------- preview: outside world → sandbox application ----------------------------------
# Certificates for *.preview.example.com: a wildcard via DNS-01, or on_demand with an /ask hook.
# Certificates per preview name on demand; sandboxd answers the ask hook only for known hosts.
# Alternative: one wildcard via a DNS plugin (xcaddy build --with github.com/caddy-dns/<provider>)
# and `tls { dns <provider> ... }` instead of on_demand.
*.preview.example.com {
	tls {
		on_demand
	}
	reverse_proxy 127.0.0.1:8082 {
		flush_interval -1
	}
}
