# Copy to .env. Everything the gateway needs to know, nothing else is configured by hand.
GATEWAY_IP=10.77.77.1                       # this VM's address on the sandbox VLAN
PREVIEW_DOMAIN=preview.example.com          # *.preview.example.com must point at this VM
PREVIEW_AUTH_URL=https://ai.example.com/api/preview/auth   # frontend endpoint that mints tickets ("" = link-only previews)
PREVIEW_TLS=                                # "" = on-demand certs; or "dns cloudflare {env.CF_API_TOKEN}" with a custom Caddy build
AGENT_IMAGE=registry.example.com/agent-sandbox/agent:latest
SANDBOXD_IMAGE=registry.example.com/agent-sandbox/sandboxd:latest
K8S_NAMESPACE=agent-sandbox
NETWORK_ATTACHMENT=agent-sandbox/sandbox-vlan
KUBECONFIG_FILE=./kubeconfig                 # from `helm` NOTES: a kubeconfig for the sandboxd ServiceAccount
POLICIES_DIR=./policies                      # checkout of your policy repository
SECRETS_DIR=./secrets                        # tenants/<tenant>/<name>, shared/<name>

# Secrets: generate with `openssl rand -hex 32`. Never commit .env.
SANDBOXD_API_TOKEN=
PREVIEW_TICKET_KEY=
POSTGRES_PASSWORD=
# DATABASE_URL=postgres://...               # set to use an external Postgres instead of the compose profile
